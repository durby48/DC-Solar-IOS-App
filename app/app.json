{
  "expo": {
    "name": "DC Solar KC",
    "slug": "dc-solar-kc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "dcsolarkc",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dcsolarkc.fieldapp",
      "appleTeamId": "E4B2Y6BWCH",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.dcsolarkc.fieldapp"]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DC Solar uses your location to stamp clock-in and clock-out punches for accurate job records.",
        "NSCameraUsageDescription": "DC Solar uses the camera to take job photos and receipt pictures.",
        "NSPhotoLibraryUsageDescription": "DC Solar uses your photo library to attach job photos and receipts.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-notifications",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1bf33f2-33a6-4730-9fb3-4b98405c2c82",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.dcsolarkc.fieldapp.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.dcsolarkc.fieldapp"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c1bf33f2-33a6-4730-9fb3-4b98405c2c82"
    }
  }
}
