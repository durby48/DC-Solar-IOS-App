# DC Solar KC app — environment template
#
# Copy to `app/.env` and fill in. EVERY key here is an `EXPO_PUBLIC_*` value,
# which means Metro substitutes it into the JavaScript bundle at build time and
# it ships to every phone and browser. Nothing secret can live in this file.
# Real secrets (service-role key, Supabase PAT, Twilio auth token, Resend key)
# live outside the repo in `~/Desktop/DC Solar LLC/secrets/` or as Supabase
# function secrets.
#
# Metro reads `.env` at bundle time, so RESTART the dev server after editing —
# and remember these must ALSO be set on EAS (`eas env:create`, or the
# `env` block of the relevant `eas.json` profile) or a production build ships
# with them blank.

# ---------------------------------------------------------------------------
# Supabase (required — the app does not start without these)
# ---------------------------------------------------------------------------
# Project URL and the anon/publishable key. The anon key is public by design:
# every row it can reach is guarded by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://kjamxfezsathrsbztiln.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Google sign-in (optional — customers only; see docs/SOCIAL_LOGIN_SETUP.md)
# ---------------------------------------------------------------------------
# OAuth client IDs from Google Cloud. Client IDs are public identifiers, not
# secrets; the Google *client secret* belongs in the Supabase auth config, not
# here. Leave both blank and the Google/Apple buttons on `sign-up.tsx` simply
# do not render.
#
# WEB client — also the audience Supabase validates every id token against,
# native included. This is the one that switches the buttons on.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS client for bundle id com.dcsolarkc.fieldapp. Its *reversed* form
# (com.googleusercontent.apps.<id>) additionally goes in `app.json` as the
# google-signin plugin's `iosUrlScheme` — see app/GOOGLE_SIGNIN_TODO.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
